# rsecret configuration file
# Place this file in the same directory as your routes file

# Redis connection settings
redis_host=127.0.0.1
redis_port=6379
redis_db=0

# Optional Redis password (comment out if not needed)
# redis_password=your_redis_password

# Enable TLS for Redis connection (0=disabled, 1=enabled)
redis_tls=0

# Connection timeout in milliseconds
timeout_ms=5000